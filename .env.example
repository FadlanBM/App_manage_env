PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-random-string-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
ENCRYPTION_KEY=change-me-to-a-random-string-32chars

# Firebase Configuration
# Opsi 1: Variabel terpisah
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opsi 2: Service account JSON utuh (string 1 baris atau base64)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Resend email invitation
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Admin Whitelist Emails (pisahkan dengan koma jika lebih dari 1).
# Jika kosong, semua user yang login via Firebase otomatis dianggap admin.
ADMIN_EMAILS=

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BASE_URL=http://localhost:3000
